.env
__pycache__/
*.pyc
output/
output_*/
venv/
.venv/
books/*.pdf

# Eval corpus: ignore the (large, downloadable) PDFs but keep manifests trackable.
corpus/**/*.pdf
corpus/raw_smoke/

# Generated eval outputs. The published artifact (test.jsonl), its provenance and
# the verification/ablation reports ARE tracked - they are the audit trail. The
# ~1 MB intermediate candidate CSVs are not: they are regenerable, and every
# accept/reject decision they encode is summarised in the reports.
eval/custom/page_texts.jsonl
eval/custom/candidates.csv
eval/custom/candidates_v2.csv
eval/custom/candidates_v3.csv
eval/custom/candidates_verified.csv
eval/custom/cross_page_candidates.csv
eval/custom/cross_page_candidates_wide.csv
eval/custom/*.csv.bak
corpus/train_smoke/
eval/custom/results/
eval/baselines/
